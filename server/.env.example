PORT=5050
# Replace with your MongoDB connection string (local, Atlas, etc.)
MONGO_URI=mongodb://127.0.0.1:27017/coderush_fleet

# Comma-separated browser origins (always includes http://localhost:5173 unless overridden)
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Optional: single production origin (https://...). Also accepts VERCEL_URL host without scheme.
# VERCEL_ORIGIN=https://your-app.vercel.app

# Tons of fuel burned per knot of SOG per hour while the ship is in a moving-capable status
# FUEL_BURN_TONS_PER_KNOT_HOUR=2.5

# LLM for distress + threat identification (optional — heuristic fallback if unset / errors)
# Provider: gemini (default) or xai (Grok via xAI OpenAI-compatible API)
# LLM_PROVIDER=gemini

# Gemini (when LLM_PROVIDER is unset or gemini)
# GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-2.0-flash

# Grok / xAI (when LLM_PROVIDER=xai or grok)
# XAI_API_KEY=your_xai_key
# XAI_MODEL=grok-3-mini-latest

# Open-Meteo configuration (Simulator uses caching + rate limiting — see Simulator.js)
# WEATHER_LATITUDE=26.0
# WEATHER_LONGITUDE=55.0
# WEATHER_WIND_SPEED_UNIT=ms
# WEATHER_CURRENT_PARAMS=wind_speed_10m,wind_direction_10m,wind_gusts_10m,wave_height
